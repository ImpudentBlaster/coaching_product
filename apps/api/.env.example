NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# Optional absolute asset directory when deploying imported exercise GIFs separately.
# EXERCISE_IMAGES_DIR=/absolute/path/to/exercise_images
WEB_ORIGIN=http://localhost:5173
# Registration and password-reset delivery. Set host/from to enable email.
# Keep real SMTP credentials only in your local environment or secret manager.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=coaching@example.com
DATABASE_URL=postgresql://coaching_app:replace-me@localhost:5432/coaching_product
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=false
# Required only when DEMO_MODE=true. Never commit real credentials.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Required only for the explicit first-admin seed command.
ADMIN_EMAIL=
ADMIN_PASSWORD=
